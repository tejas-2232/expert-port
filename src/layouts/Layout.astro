---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tejas Bachhav – Cloud DevOps Engineer. Master's in CS at Binghamton University." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      (function(){var k='portfolio-theme';var s=typeof document!=='undefined'?localStorage.getItem(k):null;var d=typeof window!=='undefined'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var light=s==='light'||(s===null&&!d);if(light)document.documentElement.classList.add('light');})();
    </script>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 font-sans antialiased" id="top">
    <Nav currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import { animate, stagger, inView } from 'motion';

      if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.motion-section').forEach((el) => {
          const h = el as HTMLElement;
          h.style.opacity = '0';
          h.style.transform = 'translateY(24px)';
        });
        document.querySelectorAll('.motion-card').forEach((el) => {
          const h = el as HTMLElement;
          h.style.opacity = '0';
          h.style.transform = 'translateY(25px)';
        });

        inView(
          '.motion-section',
          (element) => {
            animate(element, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, ease: [0.39, 0.24, 0.3, 1] });

            const cards = element.querySelectorAll('.motion-card');
            if (cards.length > 0) {
              animate(cards, { opacity: [0, 1], y: [25, 0] }, { type: 'spring', delay: stagger(0.12, { startDelay: 0.15 }) });
            }
          },
          { amount: 0.25 }
        );
      }
    </script>
  </body>
</html>
