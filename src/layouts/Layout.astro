---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Starfield from '../components/Starfield.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tejas Bachhav – Cloud DevOps Engineer. Master's in CS at Binghamton University." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ViewTransitions />
    <script is:inline>
      (function(){var k='portfolio-theme';var s=typeof document!=='undefined'?localStorage.getItem(k):null;var d=typeof window!=='undefined'&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var light=s==='light'||(s===null&&!d);if(light)document.documentElement.classList.add('light');})();
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-slate-950 text-slate-100 font-sans antialiased" id="top">
    <Starfield />
    <Nav currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import { animate, stagger, inView } from 'motion';

      function initMotion() {
        if (typeof window === 'undefined' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        /* ── Section & card fade-in ── */
        document.querySelectorAll('.motion-section').forEach((el) => {
          const h = el as HTMLElement;
          h.style.opacity = '0';
          h.style.transform = 'translateY(24px)';
        });
        document.querySelectorAll('.motion-card').forEach((el) => {
          const h = el as HTMLElement;
          h.style.opacity = '0';
          h.style.transform = 'translateY(25px)';
        });

        inView(
          '.motion-section',
          (element) => {
            animate(element, { opacity: [0, 1], y: [24, 0] }, { duration: 0.6, ease: [0.39, 0.24, 0.3, 1] });

            const cards = element.querySelectorAll('.motion-card');
            if (cards.length > 0) {
              animate(cards, { opacity: [0, 1], y: [25, 0] }, { type: 'spring', delay: stagger(0.12, { startDelay: 0.15 }) });
            }
          },
          { amount: 0.25 }
        );

        /* ── Skill pill glow on scroll ── */
        document.querySelectorAll('.skill-pill').forEach((pill) => {
          inView(pill, () => { pill.classList.add('in-view'); }, { amount: 0.5 });
        });

        /* ── Icon pulse on scroll ── */
        document.querySelectorAll('.icon-pulse').forEach((icon) => {
          const el = icon as HTMLElement;
          el.style.opacity = '0';
          el.style.transform = 'scale(0.5)';
          inView(icon, () => { icon.classList.add('in-view'); }, { amount: 0.5 });
        });

        /* ── Number counter animation ── */
        document.querySelectorAll('[data-count-up]').forEach((el) => {
          const target = parseInt(el.getAttribute('data-count-up') || '0', 10);
          if (isNaN(target) || target === 0) return;
          const htmlEl = el as HTMLElement;
          inView(el, () => {
            const obj = { val: 0 };
            animate(obj, { val: target }, {
              duration: 1.2,
              ease: [0.16, 1, 0.3, 1],
              onUpdate: () => { htmlEl.textContent = Math.round(obj.val).toString(); },
            });
          }, { amount: 0.5 });
        });

        /* ── Card tilt on hover (3D perspective) ── */
        document.querySelectorAll('.tilt-card').forEach((card) => {
          const el = card as HTMLElement;
          el.style.perspective = '600px';

          el.addEventListener('mousemove', (e: Event) => {
            const me = e as MouseEvent;
            const rect = el.getBoundingClientRect();
            const x = me.clientX - rect.left;
            const y = me.clientY - rect.top;
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;
            const rotateX = ((y - centerY) / centerY) * -6;
            const rotateY = ((x - centerX) / centerX) * 6;
            el.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          });

          el.addEventListener('mouseleave', () => {
            el.style.transform = 'rotateX(0deg) rotateY(0deg)';
          });
        });

        /* ── Magnetic hover on CTA buttons ── */
        document.querySelectorAll('.magnetic-btn').forEach((btn) => {
          const el = btn as HTMLElement;
          el.addEventListener('mousemove', (e: Event) => {
            const me = e as MouseEvent;
            const rect = el.getBoundingClientRect();
            const x = me.clientX - rect.left - rect.width / 2;
            const y = me.clientY - rect.top - rect.height / 2;
            el.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = 'translate(0px, 0px)';
            el.style.transition = 'transform 0.3s ease';
            setTimeout(() => { el.style.transition = ''; }, 300);
          });
        });

        /* ── Parallax hero background ── */
        const hero = document.getElementById('hero');
        if (hero) {
          let ticking = false;
          window.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                const scrollY = window.scrollY;
                const heroH = hero.offsetHeight;
                if (scrollY < heroH) {
                  hero.style.backgroundPositionY = `${scrollY * 0.3}px`;
                }
                ticking = false;
              });
              ticking = true;
            }
          });
        }
      }

      initMotion();
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
