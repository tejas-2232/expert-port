---
import Layout from '../layouts/Layout.astro';
import { profile, socials, stats } from '../data/profile';
import { certifications } from '../data/certifications';
import { talks } from '../data/talks';
import { openSource } from '../data/opensource';
---
<Layout title="Tejas Bachhav | Portfolio" description={profile.bio}>
  <section class="relative min-h-[90vh] overflow-hidden bg-[url('/images/bg.jpg')] bg-cover bg-center bg-no-repeat px-6 pt-20 pb-32">
    <div class="absolute inset-0 bg-slate-950/45 bg-gradient-to-b from-slate-950/65 via-slate-900/50 to-slate-950" aria-hidden="true" />
    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Hey there</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl md:text-6xl">
        I<span class="text-accent">'</span>m {profile.name}
      </h1>
      <p class="mt-6 text-lg text-slate-400">
        {profile.taglines.join(' | ')}
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/resume"
          class="inline-flex items-center rounded-lg border-2 border-accent px-6 py-3 text-sm font-medium text-accent transition hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          More About Me
        </a>
        <a
          href={profile.resumePdf}
          class="inline-flex items-center rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          Download Resume
        </a>
      </div>
    </div>
    <ul class="absolute bottom-12 left-0 right-0 z-10 flex justify-center gap-8 text-slate-400" role="list">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="text-xl transition hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950 rounded" aria-label={label}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-slate-800/50 bg-slate-900/50 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">About</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Let me introduce myself.</h2>
      <div class="mt-10 flex flex-col items-center gap-8 sm:flex-row sm:items-start">
        <img
          src={profile.image}
          alt="Tejas Bachhav"
          class="h-24 w-24 rounded-full object-cover ring-2 ring-slate-700"
          width="96"
          height="96"
        />
        <div class="flex-1 text-center sm:text-left">
          <p class="text-lg text-slate-300">
            "{profile.quote.split(' your code can reshape the world.')[0]}
            <span class="text-accent"> your code can reshape the world.</span>."
          </p>
        </div>
      </div>
      <div class="mt-14 grid gap-12 sm:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Profile</h3>
          <p class="mt-3 text-slate-400">{profile.bio}</p>
          <ul class="mt-6 space-y-2 text-sm">
            <li><strong class="text-slate-300">Full Name:</strong> <span class="text-slate-400">{profile.fullName}</span></li>
            <li><strong class="text-slate-300">Birth Date:</strong> <span class="text-slate-400">{profile.birthDate}</span></li>
            <li><strong class="text-slate-300">Websites:</strong> <a href={profile.website} class="text-accent hover:underline">{profile.website}</a></li>
            <li><strong class="text-slate-300">Email:</strong> <span class="text-slate-400">{profile.email}</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Skills & Languages</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {profile.skills.map((skill) => (
              <li><span class="rounded-md bg-slate-800 px-3 py-1 text-sm text-slate-300">{skill}</span></li>
            ))}
          </ul>
          <div class="mt-6">
            <h4 class="text-sm font-semibold text-slate-300">Languages</h4>
            <ul class="mt-2 space-y-1 text-sm text-slate-400">
              {profile.languages.map(({ name, level }) => (
                <li><strong class="text-slate-300">{name}:</strong> {level}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="rounded-lg border-2 border-accent px-6 py-3 text-sm font-medium text-accent transition hover:bg-accent/10">Hire Me</a>
        <a href={profile.resumePdf} class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover">Download Resume</a>
      </div>
    </div>
  </section>

  <section id="certifications" class="border-t border-slate-800/50 bg-slate-950 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Credentials</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Certifications & Badges</h2>
      <p class="mt-2 text-slate-400">Cloud and DevOps certifications with verification links.</p>
      <div class="mt-10 flex flex-wrap gap-6">
        {certifications.map((cert) => (
          <a
            href={cert.verifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col rounded-xl border border-slate-700/50 bg-slate-900/50 p-5 transition hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5 sm:min-w-[240px]"
          >
            <span class="font-semibold text-slate-100 group-hover:text-accent transition">{cert.name}</span>
            <span class="mt-1 text-sm text-slate-400">{cert.issuer}</span>
            {cert.year && <span class="mt-1 text-xs text-slate-500">{cert.year}</span>}
            <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-accent">
              Verify
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="talks" class="border-t border-slate-800/50 bg-slate-900/50 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Speaking</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Talks & Workshops</h2>
      <p class="mt-2 text-slate-400">Presentations at meetups and campus events.</p>
      <ul class="mt-10 space-y-10">
        {talks.map((talk) => (
          <li class="overflow-hidden rounded-2xl border border-slate-700/50 bg-slate-950/50 shadow-xl shadow-black/20">
            {talk.images && talk.images.length > 0 && (
              <div class="talks-gallery-bg relative bg-slate-900/80">
                <div class="talks-gallery flex snap-x gap-4 overflow-x-auto overscroll-x-contain px-5 py-5 scroll-smooth md:gap-5 md:px-6 md:py-6" role="region" aria-label={`Images for ${talk.title}`}>
                  {talk.images.map((src, i) => (
                    <div class="relative h-52 w-72 shrink-0 snap-center overflow-hidden rounded-xl md:h-60 md:w-80">
                      <img
                        key={src + i}
                        src={src}
                        alt={`${talk.title} – image ${i + 1}`}
                        class="h-full w-full object-cover transition duration-300 hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/10" aria-hidden="true" />
                    </div>
                  ))}
                </div>
                <div class="talks-gallery-fade pointer-events-none absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-slate-900/90 to-transparent md:w-24" aria-hidden="true" />
              </div>
            )}
            <div class="flex flex-col gap-4 border-t border-slate-700/50 p-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-lg font-semibold text-slate-100">{talk.title}</h3>
                <p class="mt-1 text-sm text-slate-400">{talk.event}</p>
                <p class="mt-0.5 text-xs text-slate-500">{talk.date}</p>
              </div>
              <div class="flex flex-wrap gap-2">
                {talk.slidesUrl && (
                  <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-accent/15 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/25 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.5a2 2 0 012 2v5.5a2 2 0 01-2 2z" /></svg>
                    Slides
                  </a>
                )}
                {talk.videoUrl && (
                  <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-accent/15 px-4 py-2 text-sm font-medium text-accent transition hover:bg-accent/25 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    Video
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="opensource" class="border-t border-slate-800/50 bg-slate-950 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Community</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Open Source</h2>
      <p class="mt-2 text-slate-400">Repos I maintain, contributions, and HacktoberFest.</p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2">
        {openSource.map((entry) => (
          <li>
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-xl border border-slate-700/50 bg-slate-900/50 p-5 transition hover:border-accent/50 hover:shadow-lg hover:shadow-accent/5"
            >
              <span class="inline-block rounded-full bg-slate-800 px-2.5 py-0.5 text-xs font-medium text-accent">
                {entry.type === 'maintainer' ? 'Maintainer' : entry.type === 'hacktoberfest' ? 'HacktoberFest' : 'Contributor'}
              </span>
              <h3 class="mt-2 font-semibold text-slate-100">{entry.title}</h3>
              <p class="mt-1 text-sm text-slate-400">{entry.description}</p>
              {entry.year && <span class="mt-2 block text-xs text-slate-500">{entry.year}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center">
        <a href="https://github.com/tejas-2232" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover font-medium">
          View all on GitHub →
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-slate-800/50 bg-gradient-to-b from-slate-800/30 to-slate-950 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-8 sm:grid-cols-3 text-center">
        {stats.map(({ value, label }) => (
          <div class="rounded-xl border border-slate-700/50 bg-slate-900/50 p-6">
            <p class="text-3xl font-semibold text-slate-100">{value}</p>
            <p class="mt-1 text-sm text-slate-400">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
