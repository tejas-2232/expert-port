---
import Layout from '../layouts/Layout.astro';
import { profile, socials, stats } from '../data/profile';
---
<Layout title="Tejas Bachhav | Portfolio" description={profile.bio}>
  <section class="relative min-h-[90vh] overflow-hidden bg-[url('/images/bg.jpg')] bg-cover bg-center bg-no-repeat px-6 pt-20 pb-32">
    <div class="absolute inset-0 bg-slate-950/45 bg-gradient-to-b from-slate-950/65 via-slate-900/50 to-slate-950" aria-hidden="true" />
    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Hey there</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl md:text-6xl">
        I<span class="text-accent">'</span>m {profile.name}
      </h1>
      <p class="mt-6 text-lg text-slate-400">
        {profile.taglines.join(' | ')}
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/resume"
          class="inline-flex items-center rounded-lg border-2 border-accent px-6 py-3 text-sm font-medium text-accent transition hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          More About Me
        </a>
        <a
          href={profile.resumePdf}
          class="inline-flex items-center rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          Download Resume
        </a>
      </div>
    </div>
    <ul class="absolute bottom-12 left-0 right-0 z-10 flex justify-center gap-8 text-slate-400" role="list">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="text-xl transition hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950 rounded" aria-label={label}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-slate-800/50 bg-slate-900/50 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">About</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Let me introduce myself.</h2>
      <div class="mt-10 flex flex-col items-center gap-8 sm:flex-row sm:items-start">
        <img
          src={profile.image}
          alt="Tejas Bachhav"
          class="h-24 w-24 rounded-full object-cover ring-2 ring-slate-700"
          width="96"
          height="96"
        />
        <div class="flex-1 text-center sm:text-left">
          <p class="text-lg text-slate-300">
            "{profile.quote.split(' your code can reshape the world.')[0]}
            <span class="text-accent"> your code can reshape the world.</span>."
          </p>
        </div>
      </div>
      <div class="mt-14 grid gap-12 sm:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Profile</h3>
          <p class="mt-3 text-slate-400">{profile.bio}</p>
          <ul class="mt-6 space-y-2 text-sm">
            <li><strong class="text-slate-300">Full Name:</strong> <span class="text-slate-400">{profile.fullName}</span></li>
            <li><strong class="text-slate-300">Birth Date:</strong> <span class="text-slate-400">{profile.birthDate}</span></li>
            <li><strong class="text-slate-300">Websites:</strong> <a href={profile.website} class="text-accent hover:underline">{profile.website}</a></li>
            <li><strong class="text-slate-300">Email:</strong> <span class="text-slate-400">{profile.email}</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Skills & Languages</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {profile.skills.map((skill) => (
              <li><span class="rounded-md bg-slate-800 px-3 py-1 text-sm text-slate-300">{skill}</span></li>
            ))}
          </ul>
          <div class="mt-6">
            <h4 class="text-sm font-semibold text-slate-300">Languages</h4>
            <ul class="mt-2 space-y-1 text-sm text-slate-400">
              {profile.languages.map(({ name, level }) => (
                <li><strong class="text-slate-300">{name}:</strong> {level}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="rounded-lg border-2 border-accent px-6 py-3 text-sm font-medium text-accent transition hover:bg-accent/10">Hire Me</a>
        <a href={profile.resumePdf} class="rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover">Download Resume</a>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-800/50 bg-gradient-to-b from-slate-800/30 to-slate-950 px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-8 sm:grid-cols-3 text-center">
        {stats.map(({ value, label }) => (
          <div class="rounded-xl border border-slate-700/50 bg-slate-900/50 p-6">
            <p class="text-3xl font-semibold text-slate-100">{value}</p>
            <p class="mt-1 text-sm text-slate-400">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
