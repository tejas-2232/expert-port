---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import HeroScene from '../components/HeroScene';
import ParticleBackground from '../components/ParticleBackground.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { profile, socials, stats } from '../data/profile';
import { certifications } from '../data/certifications';
import { talks } from '../data/talks';
import { openSource } from '../data/opensource';
import { getGitHubStats, getContributionData, formatHeatmapDate } from '../data/github';

const githubStats = await getGitHubStats();
const heatmap = await getContributionData();
const monthLabelMap = new Map(heatmap.monthLabels.map(m => [m.colIndex, m.label]));
---
<Layout title="Tejas Bachhav | Portfolio" description={profile.bio}>
  <section id="hero" class="motion-section relative min-h-[90vh] overflow-hidden bg-[url('/images/bg.jpg')] bg-cover bg-center bg-no-repeat px-4 pt-20 pb-16 sm:px-6 md:pb-32">
    <div class="absolute inset-0 bg-slate-950/45 bg-gradient-to-b from-slate-950/65 via-slate-900/50 to-slate-950" aria-hidden="true" />
    <HeroScene client:visible />
    <div class="relative z-10 mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Hey there</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-100 sm:text-4xl md:text-5xl lg:text-6xl">
        I<span class="text-accent">'</span>m {profile.name}
      </h1>
      <p class="mt-4 text-base text-slate-400 sm:mt-6 sm:text-lg">
        {profile.taglines.join(' | ')}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 sm:mt-10 sm:gap-4">
        <a
          href="/resume"
          class="magnetic-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border-2 border-accent px-5 py-3 text-sm font-medium text-accent transition hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          More About Me
        </a>
        <a
          href={profile.resumePdf}
          class="magnetic-btn inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-medium text-white transition hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          Download Resume
        </a>
      </div>
    </div>
    <ul class="relative z-10 mt-8 flex flex-wrap items-center justify-center gap-4 px-4 sm:gap-6 md:absolute md:bottom-12 md:left-0 md:right-0 md:mt-0 md:gap-8" role="list">
      {socials.map(({ href, label }) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded text-lg text-slate-400 transition hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-slate-950 sm:text-xl" aria-label={label}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* Terminal — separated from hero so the 3D scene is visible */}
  <section class="border-t border-slate-800/50 bg-gradient-to-b from-slate-950 to-slate-900/80 px-4 py-10 sm:px-6 sm:py-14">
    <div class="mx-auto max-w-2xl">
      <Terminal />
    </div>
  </section>

  <WaveDivider color="text-slate-900/50" />

  <section class="relative bg-slate-900/50 px-4 py-12 sm:px-6 sm:py-16">
    <ParticleBackground class="pointer-events-auto" />
    <div class="relative z-10 mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">About</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Let me introduce myself.</h2>
      <div class="mt-10 flex flex-col items-center gap-8 sm:flex-row sm:items-start">
        <img
          src={profile.image}
          alt="Tejas Bachhav"
          class="h-24 w-24 rounded-full object-cover ring-2 ring-slate-700"
          width="96"
          height="96"
        />
        <div class="flex-1 text-center sm:text-left">
          <p class="text-lg text-slate-300">
            "{profile.quote.split(' your code can reshape the world.')[0]}
            <span class="text-accent"> your code can reshape the world.</span>."
          </p>
        </div>
      </div>
      <div class="mt-14 grid gap-12 sm:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Profile</h3>
          <p class="mt-3 text-slate-400">{profile.bio}</p>
          <ul class="mt-6 space-y-2 text-sm">
            <li><strong class="text-slate-300">Full Name:</strong> <span class="text-slate-400">{profile.fullName}</span></li>
            <li><strong class="text-slate-300">Birth Date:</strong> <span class="text-slate-400">{profile.birthDate}</span></li>
            <li><strong class="text-slate-300">Websites:</strong> <a href={profile.website} class="text-accent hover:underline">{profile.website}</a></li>
            <li><strong class="text-slate-300">Email:</strong> <span class="text-slate-400">{profile.email}</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold uppercase tracking-wide text-slate-100">Skills & Languages</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {profile.skills.map((skill) => (
              <li><span class="skill-pill rounded-md bg-slate-800 px-3 py-1 text-sm text-slate-300 transition-all duration-300">{skill}</span></li>
            ))}
          </ul>
          <div class="mt-6">
            <h4 class="text-sm font-semibold text-slate-300">Languages</h4>
            <ul class="mt-2 space-y-1 text-sm text-slate-400">
              {profile.languages.map(({ name, level }) => (
                <li><strong class="text-slate-300">{name}:</strong> {level}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-3 sm:gap-4">
        <a href="/contact" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border-2 border-accent px-6 py-3 text-sm font-medium text-accent transition hover:bg-accent/10 focus:outline-none focus:ring-2 focus:ring-accent">Hire Me</a>
        <a href={profile.resumePdf} class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-accent px-6 py-3 text-sm font-medium text-white transition hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent">Download Resume</a>
      </div>
    </div>
  </section>

  <WaveDivider color="text-slate-950" />

  <section id="certifications" class="motion-section bg-slate-950 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-400">Credentials</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Certifications & Badges</h2>
      <p class="mt-2 text-slate-400">Cloud and DevOps certifications with verification links.</p>
      <div class="mt-10 flex flex-wrap gap-6">
        {certifications.map((cert) => (
          <a
            href={cert.verifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="motion-card tilt-card group flex flex-col rounded-xl border border-amber-500/20 bg-gradient-to-br from-amber-950/20 to-slate-900/50 p-5 transition hover:border-amber-400/50 hover:shadow-lg hover:shadow-amber-500/10 sm:min-w-[240px]"
          >
            <span class="font-semibold text-slate-100 group-hover:text-amber-400 transition">{cert.name}</span>
            <span class="mt-1 text-sm text-slate-400">{cert.issuer}</span>
            {cert.year && <span class="mt-1 text-xs text-slate-500">{cert.year}</span>}
            <span class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-amber-400">
              Verify
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="talks" class="motion-section border-t border-slate-800/50 bg-slate-900/50 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-rose-400">Speaking</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Talks & Workshops</h2>
      <p class="mt-2 text-slate-400">Presentations at meetups and campus events.</p>
      <ul class="mt-10 space-y-10">
        {talks.map((talk) => (
          <li class="overflow-hidden rounded-2xl border border-rose-500/20 bg-gradient-to-br from-rose-950/10 to-slate-950/50 shadow-xl shadow-black/20">
            {talk.images && talk.images.length > 0 && (
              <div class="talks-gallery-bg relative bg-slate-900/80">
                <div class="talks-gallery flex snap-x gap-4 overflow-x-auto overscroll-x-contain px-5 py-5 scroll-smooth md:gap-5 md:px-6 md:py-6" role="region" aria-label={`Images for ${talk.title}`}>
                  {talk.images.map((src, i) => (
                    <div class="relative h-52 w-72 shrink-0 snap-center overflow-hidden rounded-xl md:h-60 md:w-80">
                      <img
                        key={src + i}
                        src={src}
                        alt={`${talk.title} – image ${i + 1}`}
                        class="h-full w-full object-cover transition duration-300 hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 rounded-xl ring-1 ring-inset ring-white/10" aria-hidden="true" />
                    </div>
                  ))}
                </div>
                <div class="talks-gallery-fade pointer-events-none absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-slate-900/90 to-transparent md:w-24" aria-hidden="true" />
              </div>
            )}
            <div class="flex flex-col gap-4 border-t border-slate-700/50 p-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-lg font-semibold text-slate-100">{talk.title}</h3>
                <p class="mt-1 text-sm text-slate-400">{talk.event}</p>
                <p class="mt-0.5 text-xs text-slate-500">{talk.date}</p>
              </div>
              <div class="flex flex-wrap gap-2">
                {talk.slidesUrl && (
                  <a href={talk.slidesUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/15 px-4 py-2 text-sm font-medium text-rose-400 transition hover:bg-rose-500/25 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.5a2 2 0 012 2v5.5a2 2 0 01-2 2z" /></svg>
                    Slides
                  </a>
                )}
                {talk.videoUrl && (
                  <a href={talk.videoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/15 px-4 py-2 text-sm font-medium text-rose-400 transition hover:bg-rose-500/25 focus:outline-none focus:ring-2 focus:ring-rose-400 focus:ring-offset-2 focus:ring-offset-slate-950">
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                    Video
                  </a>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="opensource" class="motion-section border-t border-slate-800/50 bg-slate-950 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-400">Community</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Open Source</h2>
      <p class="mt-2 text-slate-400">Repos I maintain, contributions, and HacktoberFest.</p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2">
        {openSource.map((entry) => (
          <li>
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="tilt-card block rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-950/20 to-slate-900/50 p-5 transition hover:border-emerald-400/50 hover:shadow-lg hover:shadow-emerald-500/10"
            >
              <span class="inline-block rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-medium text-emerald-400">
                {entry.type === 'maintainer' ? 'Maintainer' : entry.type === 'hacktoberfest' ? 'HacktoberFest' : 'Contributor'}
              </span>
              <h3 class="mt-2 font-semibold text-slate-100">{entry.title}</h3>
              <p class="mt-1 text-sm text-slate-400">{entry.description}</p>
              {entry.year && <span class="mt-2 block text-xs text-slate-500">{entry.year}</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-center">
        <a href="https://github.com/tejas-2232" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-medium">
          View all on GitHub →
        </a>
      </p>
    </div>
  </section>

  <section id="activity" class="motion-section border-t border-slate-800/50 bg-slate-900/50 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">GitHub</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-100">Profile & Contributions</h2>
      <p class="mt-2 text-slate-400">Public stats and activity, kept fresh automatically.</p>

      {/* ── Stats cards ── */}
      {githubStats && (
        <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {/* Repositories — Blue */}
          <div class="motion-card tilt-card group relative overflow-hidden rounded-xl border border-blue-500/20 bg-gradient-to-br from-blue-950/40 to-slate-950/60 p-5 text-center transition hover:border-blue-400/50 hover:shadow-lg hover:shadow-blue-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 transition group-hover:opacity-100" />
            <div class="relative">
              <div class="icon-pulse mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500/10">
                <svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" />
                </svg>
              </div>
              <p class="mt-3 text-2xl font-bold text-blue-300" data-stat="repos" data-count-up={String(githubStats.publicRepos)}>{githubStats.publicRepos}</p>
              <p class="mt-1 text-xs text-slate-400">Repositories</p>
            </div>
          </div>

          {/* Followers — Purple */}
          <div class="motion-card tilt-card group relative overflow-hidden rounded-xl border border-purple-500/20 bg-gradient-to-br from-purple-950/40 to-slate-950/60 p-5 text-center transition hover:border-purple-400/50 hover:shadow-lg hover:shadow-purple-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 transition group-hover:opacity-100" />
            <div class="relative">
              <div class="icon-pulse mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500/10">
                <svg class="h-5 w-5 text-purple-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                </svg>
              </div>
              <p class="mt-3 text-2xl font-bold text-purple-300" data-stat="followers" data-count-up={String(githubStats.followers)}>{githubStats.followers}</p>
              <p class="mt-1 text-xs text-slate-400">Followers</p>
            </div>
          </div>

          {/* Following — Amber */}
          <div class="motion-card tilt-card group relative overflow-hidden rounded-xl border border-amber-500/20 bg-gradient-to-br from-amber-950/40 to-slate-950/60 p-5 text-center transition hover:border-amber-400/50 hover:shadow-lg hover:shadow-amber-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 transition group-hover:opacity-100" />
            <div class="relative">
              <div class="icon-pulse mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10">
                <svg class="h-5 w-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </div>
              <p class="mt-3 text-2xl font-bold text-amber-300" data-stat="following" data-count-up={String(githubStats.following)}>{githubStats.following}</p>
              <p class="mt-1 text-xs text-slate-400">Following</p>
            </div>
          </div>

          {/* Gists — Emerald */}
          <div class="motion-card tilt-card group relative overflow-hidden rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-950/40 to-slate-950/60 p-5 text-center transition hover:border-emerald-400/50 hover:shadow-lg hover:shadow-emerald-500/10">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 transition group-hover:opacity-100" />
            <div class="relative">
              <div class="icon-pulse mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10">
                <svg class="h-5 w-5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
                </svg>
              </div>
              <p class="mt-3 text-2xl font-bold text-emerald-300" data-stat="gists" data-count-up={String(githubStats.publicGists)}>{githubStats.publicGists}</p>
              <p class="mt-1 text-xs text-slate-400">Gists</p>
            </div>
          </div>
        </div>
      )}

      {/* ── Contribution heatmap ── */}
      <div class="mt-10">
        <div class="heatmap-container rounded-xl border border-slate-700/50 bg-slate-950/50 p-4 sm:p-6">
          <div class="overflow-x-auto">
            {/* Month labels */}
            <div class="flex gap-[3px]">
              <div class="w-7 shrink-0" />
              {heatmap.weeks.map((_w, i) => {
                const label = monthLabelMap.get(i);
                return (
                  <span class={`w-3 shrink-0 text-[10px] leading-none text-slate-500${label ? ' overflow-visible whitespace-nowrap' : ''}`}>
                    {label ?? ''}
                  </span>
                );
              })}
            </div>

            {/* Heatmap grid */}
            <div class="mt-[6px] flex gap-[3px]">
              {/* Day-of-week labels */}
              <div class="flex flex-col gap-[3px]">
                <div class="h-3 w-7" />
                <div class="flex h-3 w-7 items-center text-[10px] leading-none text-slate-500">Mon</div>
                <div class="h-3 w-7" />
                <div class="flex h-3 w-7 items-center text-[10px] leading-none text-slate-500">Wed</div>
                <div class="h-3 w-7" />
                <div class="flex h-3 w-7 items-center text-[10px] leading-none text-slate-500">Fri</div>
                <div class="h-3 w-7" />
              </div>

              {/* Week columns */}
              {heatmap.weeks.map((week) => (
                <div class="flex flex-col gap-[3px]">
                  {week.days.map((day) => (
                    <div
                      class="heatmap-cell h-3 w-3 rounded-sm"
                      data-level={day.level}
                      data-date={day.date}
                      title={`${formatHeatmapDate(day.date)}: ${day.count} contribution${day.count !== 1 ? 's' : ''}`}
                    />
                  ))}
                </div>
              ))}
            </div>
          </div>

          {/* Legend row */}
          <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
            <span id="gh-total-contributions" class="text-xs text-slate-500">
              {heatmap.totalContributions} contribution{heatmap.totalContributions !== 1 ? 's' : ''} in the last year
            </span>
            <div class="flex items-center gap-[3px] text-[10px] text-slate-500">
              <span class="mr-1">Less</span>
              {[0, 1, 2, 3, 4].map((lvl) => (
                <div class="heatmap-cell h-[10px] w-[10px] rounded-sm" data-level={lvl} />
              ))}
              <span class="ml-1">More</span>
            </div>
          </div>
        </div>
        <p class="mt-2 text-[10px] text-slate-600 italic">Contribution data from GitHub</p>
      </div>

      <p class="mt-6">
        <a
          href={githubStats?.profileUrl ?? 'https://github.com/tejas-2232'}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-accent hover:text-accent-hover"
        >
          View profile on GitHub &rarr;
        </a>
      </p>
    </div>
  </section>

  <section class="motion-section border-t border-slate-800/50 bg-gradient-to-b from-slate-800/30 to-slate-950 px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-8 sm:grid-cols-3 text-center">
        {stats.map(({ value, label }, i) => {
          const colors = [
            'border-cyan-500/20 from-cyan-950/20 text-cyan-300',
            'border-rose-500/20 from-rose-950/20 text-rose-300',
            'border-amber-500/20 from-amber-950/20 text-amber-300',
          ];
          const c = colors[i % colors.length];
          const [borderClass, fromClass, textClass] = c.split(' ');
          return (
            <div class={`motion-card tilt-card rounded-xl border ${borderClass} bg-gradient-to-br ${fromClass} to-slate-900/50 p-6`}>
              <p class={`text-3xl font-semibold ${textClass}`} data-count-up={value}>{value}</p>
              <p class="mt-1 text-sm text-slate-400">{label}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    const GH_USER = 'tejas-2232';
    const CACHE_KEY = 'gh-stats-v2';
    const CACHE_TTL = 5 * 60 * 1000;

    async function refreshStats() {
      try {
        const cached = sessionStorage.getItem(CACHE_KEY);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Date.now() - parsed.timestamp < CACHE_TTL) {
            applyStats(parsed.stats);
            return;
          }
        }
      } catch { /* ignore cache errors */ }

      try {
        const res = await fetch(`https://api.github.com/users/${GH_USER}`, {
          headers: { Accept: 'application/vnd.github.v3+json' },
        });
        if (!res.ok) return;
        const profile = await res.json();
        const stats = {
          repos: profile.public_repos ?? 0,
          followers: profile.followers ?? 0,
          following: profile.following ?? 0,
          gists: profile.public_gists ?? 0,
        };

        try {
          sessionStorage.setItem(CACHE_KEY, JSON.stringify({ stats, timestamp: Date.now() }));
        } catch { /* storage full */ }

        applyStats(stats);
      } catch {
        /* network error — keep build-time data */
      }
    }

    function applyStats(stats: Record<string, number>) {
      for (const [key, value] of Object.entries(stats)) {
        const el = document.querySelector(`[data-stat="${key}"]`);
        if (el) el.textContent = String(value);
      }
    }

    function init() {
      if (document.getElementById('activity')) {
        refreshStats();
      }
    }

    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>
