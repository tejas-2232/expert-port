---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getReadingTimeMinutes, formatReadingTime } from '../../utils/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsWithReadingTime = posts.map((entry) => {
  const body = 'body' in entry ? (entry as { body?: string }).body : undefined;
  const minutes = getReadingTimeMinutes(body);
  return { entry, readingText: formatReadingTime(minutes) };
});
---
<Layout title="Blog | Tejas Bachhav" description="Technical notes on Terraform, Ansible, DevOps, and cloud.">
  <div class="nebula-glow nebula-blue mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-400">Blog</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-100">Technical notes</h1>
    <p class="mt-2 text-slate-400">Short posts on Terraform, Ansible, incidents, and cloud.</p>

    <ul class="mt-10 space-y-8">
      {postsWithReadingTime.map(({ entry, readingText }) => (
        <li>
          <a
            href={`/blog/${entry.id}`}
            class="block rounded-xl border border-orange-500/20 bg-gradient-to-br from-orange-950/10 to-slate-950/50 p-5 transition hover:border-orange-400/50 hover:shadow-lg hover:shadow-orange-500/10"
          >
            <h2 class="font-semibold text-slate-100">{entry.data.title}</h2>
            <p class="mt-1 text-sm text-slate-400">{entry.data.description}</p>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-500">
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
              <span aria-hidden="true">·</span>
              <span>{readingText}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
