---
import Layout from '../layouts/Layout.astro';
import Animated404 from '../components/Animated404.astro';
---
<Layout title="Page not found | Tejas Bachhav" description="The page you're looking for doesn't exist.">
  <div class="mx-auto flex max-w-2xl flex-col items-center justify-center px-6 py-24 text-center">
    <Animated404 />
    <p class="mt-2 text-6xl font-bold text-amber-400/60">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-100">Lost in space</h1>
    <p class="mt-2 text-slate-400">The page you're looking for doesn't exist or has drifted into the void.</p>
    <a
      href="/"
      class="magnetic-btn mt-8 inline-flex items-center rounded-lg bg-amber-500 px-6 py-3 text-sm font-medium text-white transition hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:ring-offset-2 focus:ring-offset-slate-950"
    >
      Back to home
    </a>
  </div>
</Layout>
