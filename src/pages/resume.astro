---
import Layout from '../layouts/Layout.astro';
import ResumeTimeline from '../components/ResumeTimeline.astro';
import { workExperience, onCampus, education } from '../data/resume';
import { profile } from '../data/profile';
---
<Layout title="Resume | Tejas Bachhav" description="Work experience, on-campus roles, and education for Tejas Bachhav.">
  <div class="nebula-glow nebula-cyan mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-400">Resume</p>
    <h1 class="mt-2 text-2xl font-bold text-slate-100 sm:text-3xl">Education & Experience</h1>

    <div class="mt-8 flex flex-wrap gap-3 rounded-xl border border-indigo-500/20 bg-gradient-to-br from-indigo-950/20 to-slate-900/50 p-4 sm:gap-4 sm:p-5">
      <p class="w-full text-sm font-medium text-slate-300">Download resume</p>
      <a
        href={profile.resumePdfOnePage}
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg border-2 border-indigo-400 px-4 py-2 text-sm font-medium text-indigo-400 transition hover:bg-indigo-500/10 focus:outline-none focus:ring-2 focus:ring-indigo-400"
      >
        One-page summary
      </a>
      <a
        href={profile.resumePdfFull}
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-lg bg-indigo-500 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-400"
      >
        Full resume (PDF)
      </a>
    </div>

    <section class="mt-14">
      <h2 class="mb-8 text-xl font-semibold text-indigo-400">Work Experience</h2>
      <ResumeTimeline entries={workExperience} icon="briefcase" />
    </section>

    <section class="mt-16">
      <h2 class="mb-8 text-xl font-semibold text-indigo-400">On-Campus Experience</h2>
      <ResumeTimeline entries={onCampus} icon="user" />
    </section>

    <section class="mt-16">
      <h2 class="mb-8 text-xl font-semibold text-indigo-400">Education</h2>
      <ResumeTimeline entries={education} icon="graduation-cap" />
    </section>
  </div>
</Layout>
