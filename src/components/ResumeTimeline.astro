---
import type { TimelineEntry } from '../data/resume';

interface Props {
  entries: TimelineEntry[];
  icon: 'briefcase' | 'graduation-cap' | 'user' | 'fire';
}

const { entries, icon } = Astro.props;

const iconPaths: Record<string, string> = {
  'briefcase': 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  'graduation-cap': 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
  'user': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  'fire': 'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z',
};
const path = iconPaths[icon] || iconPaths['briefcase'];
---
<div class="space-y-8">
  {entries.map((entry) => (
    <article class="relative flex gap-6 pl-8 before:absolute before:left-[11px] before:top-2 before:h-[calc(100%-2rem)] before:w-px before:bg-slate-700">
      <div class="absolute left-0 top-0 flex h-6 w-6 items-center justify-center rounded-full bg-accent text-white" aria-hidden="true">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={path} /></svg>
      </div>
      <div class="flex-1 pb-8">
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold text-slate-100">{entry.title}</h3>
          <span class="text-sm text-slate-400">{entry.period}</span>
        </div>
        <h4 class="mb-2">
          <a href={entry.orgUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition font-medium">
            {entry.org}
          </a>
        </h4>
        {entry.description && <p class="mb-3 text-sm text-slate-400">{entry.description}</p>}
        <ul class="list-inside list-disc space-y-1 text-sm text-slate-400">
          {entry.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
      </div>
    </article>
  ))}
</div>
