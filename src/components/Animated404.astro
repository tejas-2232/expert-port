---
---
<div class="animated-404-scene relative mx-auto h-72 w-72 sm:h-80 sm:w-80" aria-hidden="true">
  <!-- Stars -->
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle class="star star-1" cx="40" cy="50" r="1.5" fill="#94a3b8" />
    <circle class="star star-2" cx="280" cy="30" r="1" fill="#94a3b8" />
    <circle class="star star-3" cx="200" cy="60" r="1.5" fill="#cbd5e1" />
    <circle class="star star-4" cx="60" cy="200" r="1" fill="#94a3b8" />
    <circle class="star star-5" cx="300" cy="180" r="1.5" fill="#cbd5e1" />
    <circle class="star star-6" cx="150" cy="20" r="1" fill="#94a3b8" />
    <circle class="star star-7" cx="20" cy="130" r="1.5" fill="#cbd5e1" />
    <circle class="star star-8" cx="260" cy="260" r="1" fill="#94a3b8" />
    <circle class="star star-1" cx="100" cy="280" r="1.5" fill="#cbd5e1" />
    <circle class="star star-3" cx="240" cy="120" r="1" fill="#94a3b8" />
    <circle class="star star-5" cx="80" cy="100" r="1.2" fill="#cbd5e1" />
    <circle class="star star-7" cx="180" cy="250" r="1" fill="#94a3b8" />
  </svg>

  <!-- Floating astronaut group -->
  <div class="astronaut absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
    <svg width="120" height="140" viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Tether line -->
      <path class="tether" d="M60 130 Q80 120 90 100 Q100 80 85 65" stroke="#475569" stroke-width="1.5" stroke-dasharray="4 3" fill="none" opacity="0.5" />

      <!-- Body -->
      <ellipse cx="60" cy="85" rx="22" ry="28" fill="#334155" stroke="#475569" stroke-width="1.5" />

      <!-- Backpack -->
      <rect x="36" y="70" width="8" height="20" rx="3" fill="#1e293b" stroke="#475569" stroke-width="1" />

      <!-- Helmet -->
      <circle cx="60" cy="48" r="22" fill="#1e293b" stroke="#475569" stroke-width="1.5" />

      <!-- Visor -->
      <ellipse cx="60" cy="48" rx="16" ry="14" fill="#0f172a" stroke="#06b6d4" stroke-width="1" opacity="0.8" />

      <!-- Visor glare -->
      <ellipse cx="54" cy="44" rx="4" ry="3" fill="#06b6d4" opacity="0.2" />

      <!-- Left arm -->
      <path d="M38 78 Q28 85 25 95" stroke="#334155" stroke-width="8" stroke-linecap="round" fill="none" />
      <circle cx="25" cy="95" r="4" fill="#334155" stroke="#475569" stroke-width="1" />

      <!-- Right arm -->
      <path d="M82 78 Q90 72 95 65" stroke="#334155" stroke-width="8" stroke-linecap="round" fill="none" />
      <circle cx="95" cy="65" r="4" fill="#334155" stroke="#475569" stroke-width="1" />

      <!-- Left leg -->
      <path d="M48 110 Q42 120 38 130" stroke="#334155" stroke-width="7" stroke-linecap="round" fill="none" />
      <ellipse cx="37" cy="132" rx="5" ry="3" fill="#1e293b" stroke="#475569" stroke-width="1" />

      <!-- Right leg -->
      <path d="M72 110 Q78 118 82 128" stroke="#334155" stroke-width="7" stroke-linecap="round" fill="none" />
      <ellipse cx="83" cy="130" rx="5" ry="3" fill="#1e293b" stroke="#475569" stroke-width="1" />

      <!-- Antenna -->
      <line x1="60" y1="26" x2="60" y2="18" stroke="#475569" stroke-width="1.5" />
      <circle cx="60" cy="16" r="3" fill="#06b6d4" class="antenna-light" />
    </svg>
  </div>

  <!-- Planet -->
  <div class="planet absolute bottom-4 right-4">
    <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="25" cy="25" r="20" fill="#1e293b" stroke="#334155" stroke-width="1.5" />
      <ellipse cx="25" cy="25" rx="28" ry="6" stroke="#475569" stroke-width="1" fill="none" transform="rotate(-20 25 25)" />
      <circle cx="18" cy="20" r="3" fill="#0f172a" opacity="0.4" />
      <circle cx="30" cy="28" r="4" fill="#0f172a" opacity="0.3" />
      <circle cx="22" cy="32" r="2" fill="#0f172a" opacity="0.3" />
    </svg>
  </div>
</div>

<style>
  /* Floating astronaut */
  .astronaut {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translate(-50%, -50%) rotate(-3deg); }
    50% { transform: translate(-50%, calc(-50% - 12px)) rotate(3deg); }
  }

  /* Twinkling stars */
  .star {
    animation: twinkle 3s ease-in-out infinite;
  }
  .star-1 { animation-delay: 0s; }
  .star-2 { animation-delay: 0.4s; }
  .star-3 { animation-delay: 0.8s; }
  .star-4 { animation-delay: 1.2s; }
  .star-5 { animation-delay: 1.6s; }
  .star-6 { animation-delay: 2.0s; }
  .star-7 { animation-delay: 2.4s; }
  .star-8 { animation-delay: 2.8s; }
  @keyframes twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* Antenna blink */
  .antenna-light {
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; fill: #06b6d4; }
    50% { opacity: 0.3; fill: #0891b2; }
  }

  /* Planet subtle rotation */
  .planet {
    animation: planet-bob 8s ease-in-out infinite;
  }
  @keyframes planet-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  /* Tether sway */
  .tether {
    animation: tether-sway 6s ease-in-out infinite;
  }
  @keyframes tether-sway {
    0%, 100% { d: path("M60 130 Q80 120 90 100 Q100 80 85 65"); }
    50% { d: path("M60 130 Q75 125 85 105 Q95 85 88 68"); }
  }

  @media (prefers-reduced-motion: reduce) {
    .astronaut, .star, .antenna-light, .planet, .tether {
      animation: none;
    }
  }
</style>
