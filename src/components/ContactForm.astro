---
import { formspreeEndpoint } from '../data/contact';
---
<form
  action={formspreeEndpoint}
  method="POST"
  class="mx-auto max-w-xl space-y-6"
>
  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
  <div>
    <label for="name" class="mb-1 block text-sm font-medium text-slate-300">Your name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength={2}
      placeholder="Your Good Name"
      class="w-full min-h-[44px] rounded-lg border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400"
    />
  </div>
  <div>
    <label for="email" class="mb-1 block text-sm font-medium text-slate-300">Email</label>
    <input
      type="email"
      id="email"
      name="_replyto"
      required
      placeholder="Email ID"
      class="w-full min-h-[44px] rounded-lg border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400"
    />
  </div>
  <div>
    <label for="subject" class="mb-1 block text-sm font-medium text-slate-300">Subject</label>
    <input
      type="text"
      id="subject"
      name="_subject"
      placeholder="What is this about?"
      class="w-full min-h-[44px] rounded-lg border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400"
    />
  </div>
  <div>
    <label for="message" class="mb-1 block text-sm font-medium text-slate-300">Message</label>
    <textarea
      id="message"
      name="message"
      required
      rows={6}
      placeholder="Start typing from here..."
      class="w-full resize-y rounded-lg border border-slate-700 bg-slate-900/50 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-400"
    />
  </div>
  <button
    type="submit"
    class="w-full min-h-[48px] rounded-lg bg-emerald-500 px-6 py-3 font-medium text-white transition hover:bg-emerald-400 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-950"
  >
    Send message
  </button>
</form>
